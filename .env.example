# Microsoft Azure App credentials
# Créer l'app sur https://portal.azure.com > Azure Active Directory > App registrations
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=your-tenant-id-here
# Pour le flow "device code" (pas besoin de client secret)
# AZURE_CLIENT_SECRET=your-client-secret-here

# Modèle Ollama à utiliser
OLLAMA_MODEL=gemma4:e2b

# Polling interval en secondes (300 = 5 minutes)
POLL_INTERVAL=300

# Heure du résumé journalier (format HH:MM)
DAILY_SUMMARY_TIME=08:00
